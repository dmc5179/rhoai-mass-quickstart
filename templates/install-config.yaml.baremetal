# Template install-config for a connected OCP 4.22 cluster on bare metal,
# installed with the agent-based installer.
#
# Placeholder values marked CHANGEME are filled in by
# generate-install-config.sh from cluster.env. Do not install from this file
# directly.
#
# The agent-based installer builds a bootable ISO from this file plus
# agent-config.yaml, and you start the machines yourself. There is no BMC
# access and no provisioning network, which is what makes it the practical
# choice for most lab hardware. Phase 10 runs
# `openshift-install agent create image` rather than `create cluster`.
#
# Note there is deliberately no platform.baremetal.hosts list here. That field
# is required for BMC-driven installs (platform.baremetal IPI), but for
# agent-based installs the host details live in agent-config.yaml instead, and
# are only needed at all for static networking or disk selection.
apiVersion: v1
baseDomain: CHANGEME
compute:
- architecture: amd64
  hyperthreading: Enabled
  name: worker
  replicas: 2
controlPlane:
  architecture: amd64
  hyperthreading: Enabled
  name: master
  replicas: 3
metadata:
  name: CHANGEME
networking:
  clusterNetwork:
  - cidr: 10.128.0.0/14
    hostPrefix: 23
  # Must match the subnet the nodes sit on.
  machineNetwork:
  - cidr: CHANGEME
  networkType: OVNKubernetes
  serviceNetwork:
  - 172.30.0.0/16
platform:
  baremetal:
    # Two free IPs on the machine network, not in any DHCP pool. These must
    # resolve as api.<cluster>.<basedomain> and *.apps.<cluster>.<basedomain>.
    apiVIPs:
    - CHANGEME
    ingressVIPs:
    - CHANGEME
publish: External
fips: false
pullSecret: ''
sshKey: ''
