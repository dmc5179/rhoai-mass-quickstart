# Template install-config for a connected OCP 4.22 cluster on AWS, in the
# pre-existing VPC built by cloudformation/01_vpc.yaml.
#
# Placeholder values marked CHANGEME are filled in by generate-install-config.sh from the
# CloudFormation stack outputs and the local environment. Do not install from this
# file directly.
apiVersion: v1
baseDomain: CHANGEME
credentialsMode: Mint
compute:
- architecture: amd64
  hyperthreading: Enabled
  name: worker
  platform:
    aws:
      # Overridden by AWS_WORKER_TYPE / AWS_WORKER_REPLICAS in cluster.env.
      type: m6i.4xlarge
      zones:
      - CHANGEME
  replicas: 3
controlPlane:
  architecture: amd64
  hyperthreading: Enabled
  name: master
  platform:
    aws:
      # Overridden by AWS_CONTROL_PLANE_TYPE / _REPLICAS in cluster.env.
      #
      # NOT m6i.xlarge. 4 vCPU / 16 GiB is the documented control plane
      # minimum, and Red Hat qualifies it as sufficient only for an etcd
      # database up to ~250 MiB and low load
      # (access.redhat.com/articles/7132959). An ACM hub is not low load: on
      # this stack etcd reached a 545 MB high-water mark, at which point the
      # API server began timing out, ovnkube-controller crash-looped because
      # it could not write a node annotation, and nodes went NotReady with no
      # CNI configuration. None of that presents as "the control plane is too
      # small".
      type: m6i.2xlarge
      zones:
      - CHANGEME
  replicas: 3
metadata:
  name: CHANGEME
networking:
  clusterNetwork:
  - cidr: 10.128.0.0/14
    hostPrefix: 23
  # Must match the VPC CIDR from 01_vpc.yaml. Never overlap 100.64.0.0/16,
  # which OVN-Kubernetes uses for its own internal subnet.
  machineNetwork:
  - cidr: 10.0.0.0/16
  networkType: OVNKubernetes
  serviceNetwork:
  - 172.30.0.0/16
platform:
  aws:
    region: CHANGEME
    # platform.aws.subnets (a flat list of IDs) is deprecated in 4.22 in favour
    # of platform.aws.vpc.subnets with explicit roles. Roles are assigned here
    # rather than left to auto-discovery, because auto-discovery requires that
    # the VPC contain no non-cluster subnets - which would defeat the point of
    # keeping this VPC independent of the cluster.
    #
    # generate-install-config.sh replaces this whole block with the InstallConfigSubnets
    # output of the VPC stack.
    vpc:
      subnets:
      - id: CHANGEME
        roles:
        - type: IngressControllerLB
        - type: ControlPlaneExternalLB
        - type: BootstrapNode
      - id: CHANGEME
        roles:
        - type: ClusterNode
        - type: ControlPlaneInternalLB
publish: External
fips: false
pullSecret: ''
sshKey: ''
