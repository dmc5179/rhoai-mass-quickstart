# Non-secret settings for the cluster build. Safe to commit.
# Secrets (cloud credentials, pull secret, SSH key) live in secrets/.
#
# Sourced by the scripts in scripts/, which set ROOT to the repository root
# before sourcing. Paths below are built from ${ROOT} so they resolve the same
# way no matter which directory you run the scripts from.

# ---------------------------------------------------------------------------
# Target platform
# ---------------------------------------------------------------------------
# aws       - installer-provisioned, into the VPC built by cloudformation/
# ibmcloud  - installer-provisioned on IBM Cloud VPC
# baremetal - see templates/install-config.yaml.baremetal before using
PLATFORM="aws"

# ---------------------------------------------------------------------------
# Common
# ---------------------------------------------------------------------------

# OpenShift cluster name. Combined with the base domain to form the cluster's
# DNS, e.g. <CLUSTER_NAME>.<BASE_DOMAIN>.
CLUSTER_NAME="rhoai"

# Base domain.
#   aws       - leave blank to auto-detect the single public Route 53 hosted
#               zone in the account; set it if there is more than one.
#   ibmcloud  - required. Must be a domain zone in IBM Cloud Internet Services
#               (CIS) in the same account, or IBM Cloud DNS Services for a
#               private cluster. Not auto-detected.
#   baremetal - required.
BASE_DOMAIN=""

# ---------------------------------------------------------------------------
# AWS
# ---------------------------------------------------------------------------

# Name of the CloudFormation stack that owns the VPC. Created by
# 10-deploy-cluster.sh if it does not exist. Intentionally separate from the
# cluster so that destroying the cluster leaves the VPC standing.
VPC_STACK_NAME="rhoai-vpc"

# Naming prefix for the VPC stack's resources. Not tied to the cluster name.
VPC_INFRA_NAME="rhoai"

# CIDR for the VPC. Must match networking.machineNetwork in the install-config
# template. Must not overlap 100.64.0.0/16.
VPC_CIDR="10.0.0.0/16"

# Availability zone for the VPC subnets. Leave blank to use the first AZ in the
# region. Pin this when you need an AZ that offers a particular instance type.
VPC_AZ=""

# Machine sizing. These are sized for a cluster that will run an ACM hub plus
# RHOAI, not for a bare OpenShift install.
#
# The control plane minimum of 4 vCPU / 16 GiB (m6i.xlarge) is documented as
# sufficient only for an etcd database up to ~250 MiB and low load
# (access.redhat.com/articles/7132959). An ACM hub is not low load. Running one
# on the minimum produced a 545 MB etcd, API server timeouts, a crash-looping
# ovnkube-controller, and nodes stuck NotReady with no CNI configuration -
# none of which looks like a sizing problem from the symptoms.
AWS_CONTROL_PLANE_TYPE="m6i.2xlarge"     # 8 vCPU / 32 GiB
AWS_CONTROL_PLANE_REPLICAS="3"

# Workers carry the operators. Three m6i.2xlarge reached 99% of allocatable CPU
# requested with the full AutoShift policy set enabled, which left pods Pending
# and webhooks without endpoints. Raise the count rather than the size if you
# would rather spread the load.
AWS_WORKER_TYPE="m6i.4xlarge"            # 16 vCPU / 64 GiB
AWS_WORKER_REPLICAS="3"

# GPU machine sets, created at replica 0 by scripts/add-gpu-machinesets.sh and
# scaled up on demand:
#
#   "$OC" scale machineset/<name> -n openshift-machine-api --replicas=1
#
# g6.xlarge is an L4 with 24 GB VRAM, which covers the guide's granite-tiny-gpu,
# gemma, and gpt-oss-20b models. g5.xlarge (A10G, 24 GB) is the older
# equivalent and is sometimes easier to get capacity for.
#
# AWS only - the machine set script reads AWS-specific providerSpec fields.
GPU_INSTANCE_TYPE="g6.xlarge"

# ---------------------------------------------------------------------------
# Models as a Service
# ---------------------------------------------------------------------------

# Which model phase 20 deploys. "auto" lets the guide choose based on whether
# a GPU node is present - but note it falls back to the CPU simulator SILENTLY
# when it finds none, and still reports success. Pin a name to make a missing
# GPU an obvious failure instead of a quiet downgrade.
#
#   auto              guide decides
#   simulator         CPU, no GPU needed, tiny stub responses
#   qwen3-06b         CPU, real inference, needs ~16 GiB RAM
#   granite-tiny-gpu  GPU, ~8 GiB VRAM, OCI modelcar from registry.redhat.io
#   gemma             GPU, ~12 GiB VRAM, OCI modelcar
#   gpt-oss-20b       GPU, ~16 GiB VRAM, OCI modelcar
#
# Run scripts/15-gpu-node.sh up before phase 20 for any of the GPU models.
MAAS_MODEL="granite-tiny-gpu"

# ---------------------------------------------------------------------------
# IBM Cloud
# ---------------------------------------------------------------------------
# Credentials come from secrets/ibm.env (IC_API_KEY / IBMCLOUD_API_KEY).

IBM_REGION="us-south"

# Resource group for the cluster. Leave blank to use the account default.
IBM_RESOURCE_GROUP=""

# Existing VPC to install into. Leave IBM_VPC_NAME blank to have the installer
# create and own the VPC - note that this couples the network to the cluster
# lifecycle, unlike the AWS path. To reuse a VPC, set all three.
IBM_VPC_NAME=""
IBM_CONTROL_PLANE_SUBNETS=""   # comma-separated subnet names
IBM_COMPUTE_SUBNETS=""

# Machine profiles. bx2-8x32 is 8 vCPU / 32 GB, roughly the m6i.2xlarge used on
# AWS; bx2-4x16 is the documented control plane minimum.
IBM_CONTROL_PLANE_PROFILE="bx2-4x16"
IBM_COMPUTE_PROFILE="bx2-8x32"

# ---------------------------------------------------------------------------
# Bare metal (agent-based installer)
# ---------------------------------------------------------------------------
# Phase 10 builds a bootable ISO instead of calling out to a cloud API. You
# boot the machines from it yourself; no BMC access is needed.

# Two free IPs on the machine network, outside any DHCP pool. DNS must resolve
# api.<CLUSTER_NAME>.<BASE_DOMAIN> to BM_API_VIP and
# *.apps.<CLUSTER_NAME>.<BASE_DOMAIN> to BM_INGRESS_VIP.
BM_API_VIP=""
BM_INGRESS_VIP=""

# Subnet the nodes sit on.
BM_MACHINE_CIDR="10.0.0.0/16"

# Address of the node that bootstraps the cluster. Must be one of the machines
# you boot from the ISO, and must be a control plane node. Needs to be stable,
# so use a static address or a DHCP reservation.
BM_RENDEZVOUS_IP=""

# Node counts. 3/0 is a compact cluster (control plane nodes also run
# workloads); 1/0 with BM_API_VIP and BM_INGRESS_VIP left blank is
# single-node OpenShift.
BM_CONTROL_PLANE_REPLICAS="3"
BM_COMPUTE_REPLICAS="2"

# ---------------------------------------------------------------------------
# AutoShift (optional, phase 50)
# ---------------------------------------------------------------------------
# Puts the cluster under RHACM + GitOps so RHOAI/MaaS arrive as policies
# instead of the imperative phases 15-40. Requires an AutoShift checkout,
# which is not vendored here.

AUTOSHIFT_DIR="${HOME}/workspace/autoshiftv2-mine"

# The ApplicationSet reads policy charts from GIT, not from AUTOSHIFT_DIR.
# Policy edits do nothing until they are pushed to this branch.
AUTOSHIFT_GIT_REPO="https://github.com/dmc5179/autoshiftv2.git"
AUTOSHIFT_GIT_BRANCH="rhoai-maas"

# Clusterset the hub joins, and the values file read for it.
AUTOSHIFT_CLUSTERSET="hub"

# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------

# Where the installer writes its state. Keep this: it holds the kubeconfig, the
# kubeadmin password, and the metadata needed to destroy the cluster.
CLUSTER_DIR="${ROOT:?cluster.env must be sourced with ROOT set}/clusters/${CLUSTER_NAME}"

# Credentials.
PULL_SECRET_FILE="${ROOT}/secrets/pull-secret.json"
SSH_KEY_FILE="${HOME}/.ssh/id_rsa.pub"
